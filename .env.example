# Base URL every API endpoint id is appended to (no trailing slash).
# Endpoint ids live in src/config.ts, so a call resolves to:
#   ${API_BASE_URL}/<endpoint-id>
API_BASE_URL=https://your-api-host.example.com

# Password used to seal the session cookie. Minimum 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-at-least-32-random-characters

# Socket.IO endpoint for the platform chat system (v1 / receiver-chatsystem).
SOCKET_URL=wss://wss.vizru.studio

# Optional. Only needed for tenant-wide broadcasts and the online-user roster;
# per-user messages work without it. Leave blank to omit it from the handshake.
SOCKET_TENANT_ID=

# Gate token for the Socket.IO handshake. Signed with the chat server's shared
# secret — NOT a user token. The user's own JWT goes in vizru_user.auth_token.
SOCKET_HANDSHAKE_TOKEN=
